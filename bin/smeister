"""SpiceMeister CLI launcher (symlink-safe).

Resolves the repo root from this script's real path so the package is importable
even when invoked through a symlink in ~/.local/bin.
"""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_root = os.path.dirname(_here)
if _root not in sys.path:
    sys.path.insert(0, _root)

from spicemeister.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
